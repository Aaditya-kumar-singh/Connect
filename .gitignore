# ============================================================
# YBM Connect — Git Ignore Rules
# ============================================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
credentials/
secrets/

# Rust / Cargo
**/target/
target/

# Node.js / Web Frontend (Next.js)
node_modules/
.next/
out/
build/
dist/
.turbo/
.npm/

# Mobile (React Native / Expo)
frontend/mobile/.expo/
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Database / Storage Volumes
pgdata/
minio_data/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lcov.info
coverage/

# OS & Editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
