{application, ybm_reliability,
 [{description, "YBM Connect Erlang/OTP reliability service"},
  {vsn, "0.1.0"},
  {registered, []},
  {mod, {ybm_reliability_app, []}},
  {applications, [kernel, stdlib, crypto, inets]},
  {env, [
      {redis_host, "127.0.0.1"},
      {redis_port, 6379},
      {redis_password, ""},
      {redis_db, 0},
      {health_port, 8081},
      {pg_host, "127.0.0.1"},
      {pg_port, 5432},
      {r2_endpoint, "http://127.0.0.1:9000"},
      {probe_interval_pg, 15000},
      {probe_interval_redis, 10000},
      {probe_interval_storage, 30000},
      {pg_failure_threshold, 5},
      {pg_cooldown_ms, 30000},
      {pg_success_threshold, 2},
      {redis_failure_threshold, 5},
      {redis_cooldown_ms, 15000},
      {redis_success_threshold, 2},
      {storage_failure_threshold, 3},
      {storage_cooldown_ms, 30000},
      {storage_success_threshold, 1}
  ]}]}.
