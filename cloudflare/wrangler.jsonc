{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ybm-connect-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "YbmBackend",
      "image": "../backend/Dockerfile",
      "image_build_context": "..",
      "max_instances": 3,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "YBM_BACKEND",
        "class_name": "YbmBackend"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["YbmBackend"]
    }
  ]
}