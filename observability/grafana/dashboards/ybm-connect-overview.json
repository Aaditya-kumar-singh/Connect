{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"ybm-connect\"}[5m]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx Rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"ybm-connect\",status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 Latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds{service=\"ybm-connect\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active WebSockets",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "ws_connections_active{service=\"ybm-connect\"}",
          "legendFormat": "connections",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL Pool Usage",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "db_pool_connections_active{service=\"ybm-connect\"}",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "db_pool_connections_idle{service=\"ybm-connect\"}",
          "legendFormat": "idle",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WebSocket Messages",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(ws_messages_received_total{service=\"ybm-connect\"}[5m]))",
          "legendFormat": "received {{type}}",
          "refId": "A"
        },
        {
          "expr": "sum by (type) (rate(ws_messages_sent_total{service=\"ybm-connect\"}[5m]))",
          "legendFormat": "sent {{type}}",
          "refId": "B"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "ybm-connect",
    "observability"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "YBM Connect Overview",
  "uid": "ybm-connect-overview",
  "version": 1
}